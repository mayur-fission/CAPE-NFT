# Template for .env - copy this file to .env in the repo root and fill in the
# values (.env is git-ignored, so the real URL, users, passwords and tokens
# never reach git). Lines starting with # are optional settings with their defaults.

# =============================================================================
# Posit Workbench server and users
# Used by every UI test (login) and every API test (api_helper.py).
# user=N in the code means RSTUDIO_USER<N> / RSTUDIO_PASSWORD<N> (user 1 has
# no suffix) and API token API_TOKEN_USER_<N>.
# =============================================================================
RSTUDIO_BASE_URL=
# API host; defaults to the host of RSTUDIO_BASE_URL
#WORKBENCH_SERVER_URL=

RSTUDIO_USER1=
RSTUDIO_PASSWORD=
API_TOKEN_USER_1=

RSTUDIO_USER2=
RSTUDIO_PASSWORD2=
API_TOKEN_USER_2=

# =============================================================================
# Shared session settings (most UI tests)
# =============================================================================
# Working directory set in a new session before running a script
RSTUDIO_WORKING_DIR=
# Number of sessions for the multi-session tests. Required by
# test_create_sessions_run_r_close_browser, test_run_high_throughput_job and
# test_us_168
RSTUDIO_SESSION_COUNT=
# Cap on parallel browsers in concurrent tests; unset = one per session.
# test_rstudio_session_perf, test_rstudio_source_script_perf
RSTUDIO_CONCURRENT_MAX_WORKERS=
#RSTUDIO_SESSION_TYPE=RStudio Pro

# =============================================================================
# Idle sessions - test_rstudio_sessions
# =============================================================================
RSTUDIO_SESSION_IDLE_MINUTES=
RSTUDIO_FILE_LIST_POLL_INTERVAL_SECONDS=

# =============================================================================
# Launch performance - test_rstudio_session_perf
# =============================================================================
# Fails the run if p95 launch time exceeds this; unset = no limit
RSTUDIO_LAUNCH_P95_MAX_SECONDS=
#RSTUDIO_TEXT_FILE_COUNT=3

# =============================================================================
# Script in existing sessions - test_rstudio_source_script_perf
# The sessions must already exist; nothing is created.
# =============================================================================
RSTUDIO_SCRIPT_SOURCE_COMMAND=
RSTUDIO_SCRIPT_TIMEOUT_MS=
#RSTUDIO_SCRIPT_WORKING_DIR=/home/posit
#RSTUDIO_SCRIPT_SESSION_NAME=AUTO_SESSION_1
# Concurrent test: comma-separated session names, else
# AUTO_SESSION_1..RSTUDIO_CONCURRENT_USERS
#RSTUDIO_SCRIPT_SESSION_NAMES=
#RSTUDIO_CONCURRENT_USERS=3
#RSTUDIO_REQUESTS_PER_USER=1
#RSTUDIO_THINK_TIME_SECONDS=0

# =============================================================================
# Script in new sessions - test_rstudio_run_r_script_perf,
# test_create_and_launch_multiple_sessions_user1 / _user2
# =============================================================================
RSTUDIO_RUN_SCRIPT_SOURCE_COMMAND=
RSTUDIO_RUN_SCRIPT_TIMEOUT_MS=
# Runs per session, and the pause between runs
RSTUDIO_RUN_SCRIPT_COUNT=
RSTUDIO_RUN_SCRIPT_THINK_TIME_SECONDS=
# Concurrent tests: simultaneous users, and a cap on parallel browsers
RSTUDIO_RUN_SCRIPT_CONCURRENT_USERS=
RSTUDIO_RUN_SCRIPT_CONCURRENT_MAX_WORKERS=
# user1/user2 tests: how often to check the running scripts
#RSTUDIO_RUN_SCRIPT_MONITOR_POLL_INTERVAL_SECONDS=2

# =============================================================================
# Close the tab while a script runs - test_create_sessions_run_r_close_browser
# (the close-tab tests in test_run_high_throughput_job use the duration too)
# =============================================================================
RSTUDIO_WORKBENCH_JOB_SCRIPT=
# How long the sessions run unattended before being reopened or quit
RSTUDIO_WORKBENCH_JOB_TEST_DURATION_SECONDS=

# =============================================================================
# High-throughput script - test_us_167, test_us_168,
# test_run_high_throughput_job, test_launch_existing_session_and_run_r_scripts
# =============================================================================
# Alternatives: /home/posit/sample_run_sleep.R,
# /home/posit/sample_100mb_and_generate_10kb.R
HIGH_THROUGHPUT_JOB_SCRIPT=
# test_us_167 / test_us_168: time limit for each script run
HIGH_THROUGHPUT_JOB_TEST_DURATION_SECONDS=
# Time limit for each run in the other tests
#HIGH_THROUGHPUT_JOB_TIMEOUT_MS=1800000
# Each session writes its output file here (or in <dir>/<session name>)
#HIGH_THROUGHPUT_JOB_OUTPUT_DIR=/home/posit
# test_launch_existing_session_and_run_r_scripts: false = keep output files
#HIGH_THROUGHPUT_JOB_DELETE_OUTPUT=true

# =============================================================================
# Sessions created through the API - test_create_session_through_api_and_run_script,
# test_create_session_through_api_and_run_script_group,
# test_launch_existing_session_and_run_r_scripts
# =============================================================================
# User who creates and opens the sessions (picks testdata/*_U<user>.csv)
#CSV_SESSIONS_USER=1
# Defaults to testdata/session_names_U<CSV_SESSIONS_USER>.csv
#CSV_SESSIONS_NAMES_CSV=
#CSV_SESSIONS_SCRIPT=/home/posit/batch_mayur/generate_10kb_csv.R
#CSV_SESSIONS_OUTPUT_DIR=/home/posit
# Existing sessions AUTO_API_SESSION_<START..END>
#API_SESSION_START=105
#API_SESSION_END=109
# Opening an existing (possibly suspended) session
#OPEN_SESSION_TIMEOUT_MS=120000
#CONSOLE_READY_TIMEOUT_MS=120000
# Group test: total run time, group A list.files() interval, group B job script
#GROUP_SESSIONS_TEST_DURATION_S=300
#GROUP_A_LIST_FILES_INTERVAL_S=30
#GROUP_B_WORKBENCH_JOB_SCRIPT=/home/posit/sample_run_sleep.R

# =============================================================================
# Metrics - perf tests (best effort; tests pass without them)
# =============================================================================
# OTLP collector for OTel metrics; unset = print metrics to the console
OTEL_EXPORTER_OTLP_ENDPOINT=
RSTUDIO_OTEL_SERVICE_NAME=
# CloudWatch server/DB metrics for the last N minutes
#RSTUDIO_METRICS_WINDOW_MINUTES=5
#RSTUDIO_SERVER_INSTANCE_ID=
#RSTUDIO_DB_INSTANCE_ID=
#AWS_REGION=eu-west-1
