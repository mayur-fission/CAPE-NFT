# Template for .env: copy this file to .env and fill in the blank values.
# Never put real URLs, users, passwords or tokens in this file - it is in git.

# --- Workbench server and users (user N = RSTUDIO_USER<N> / RSTUDIO_PASSWORD<N> / API_TOKEN_USER_<N>; user 1's password has no suffix)
# sign-in page, e.g. http://<host>:8787/auth-sign-in
RSTUDIO_BASE_URL=
RSTUDIO_USER1=
RSTUDIO_PASSWORD=
# API tests only
API_TOKEN_USER_1=
RSTUDIO_USER2=
RSTUDIO_PASSWORD2=
# API tests only
API_TOKEN_USER_2=

# --- Server paths (no defaults in the code - each test needs its own set)
# test user's home folder
WORKBENCH_HOME_DIR=/home/posit
# working folder for new sessions (also API tests)
RSTUDIO_WORKING_DIR=/home/posit
# test_167 / 168 / 167_multiple_times / run_high_throughput_job / launch_existing
R_SCRIPT_HIGH_THROUGHPUT=/home/posit/generate_10kb_csv.R
OUTPUT_DIR_HIGH_THROUGHPUT=/home/posit
# test_run_r_close_browser
R_SCRIPT_CLOSE_TAB_JOB=/home/posit/batch_mayur/git_status_5sec.R
# group / CSV-session tests, and test_concurrent_sessions
R_SCRIPT_GENERATE_CSV=/home/posit/batch_mayur/generate_10kb_csv.R
OUTPUT_DIR_GENERATE_CSV=/home/posit
# group tests, group B
R_SCRIPT_GROUP_B_WORKBENCH_JOB=/home/posit/sample_run_sleep.R
R_SCRIPT_GROUP_B_BACKGROUND_JOB=/home/posit/batch_mayur/git_status_5sec.R
# test_concurrent_sessions_10min
R_SCRIPT_CONCURRENT_10MIN=/home/posit/batch_mayur/htp_10min.R
# test_concurrent_sessions_30min
R_SCRIPT_CONCURRENT_30MIN=/home/posit/batch_mayur/htp_30min.R
# test_concurrent_sessions_10min_s (writes data/, tables/, logs/ in each session's folder)
R_SCRIPT_SMALL_10MIN=/home/posit/batch_mayur/pmx_10kb_10min.R
# perf tests that create sessions
R_SOURCE_COMMAND_NEW_SESSIONS=source('sample_100mb.R')
# test_rstudio_source_script_perf
R_SOURCE_COMMAND_EXISTING_SESSIONS=source('sample_10mb.R')

# --- Session counts
# sessions per multi-session test
RSTUDIO_SESSION_COUNT=3
# cap on parallel browsers
RSTUDIO_CONCURRENT_MAX_WORKERS=3
# concurrent tests (all three): seconds between starting one browser and the next
CONCURRENT_SESSIONS_BROWSER_STAGGER_S=30
# test_create_session_through_ui_and_run_script_group_multi_browser: seconds between starting one browser and the next
GROUP_SESSIONS_UI_BROWSER_STAGGER_S=30

# --- Timings and limits
# time limit per high-throughput run
HIGH_THROUGHPUT_JOB_TEST_DURATION_SECONDS=240
# how long sessions run with tabs closed
RSTUDIO_WORKBENCH_JOB_TEST_DURATION_SECONDS=240
# script timeout in existing sessions
RSTUDIO_SCRIPT_TIMEOUT_MS=600000
# script timeout in new sessions
RSTUDIO_RUN_SCRIPT_TIMEOUT_MS=600000
# runs per session
RSTUDIO_RUN_SCRIPT_COUNT=3
# pause between runs
RSTUDIO_RUN_SCRIPT_THINK_TIME_SECONDS=5
# simultaneous users
RSTUDIO_RUN_SCRIPT_CONCURRENT_USERS=3
# cap on parallel browsers
RSTUDIO_RUN_SCRIPT_CONCURRENT_MAX_WORKERS=3
# fail if p95 launch time is above this
RSTUDIO_LAUNCH_P95_MAX_SECONDS=60
# test_rstudio_sessions idle time
RSTUDIO_SESSION_IDLE_MINUTES=3
# test_rstudio_sessions poll interval
RSTUDIO_FILE_LIST_POLL_INTERVAL_SECONDS=30

# --- test_run_r_close_browser (sessions left running with their tabs closed)
# number of sessions
CLOSE_TAB_SESSION_COUNT=3
# seconds the sessions run with their tabs closed (the Jenkins CLOSE_BROWSER_WAIT_S field wins when set)
CLOSE_TAB_TEST_DURATION_S=240
# seconds between checks of the session list for dropped sessions
CLOSE_TAB_MONITOR_INTERVAL_S=30
# true = reopen each session and stop its R script before the sessions are quit
CLOSE_TAB_STOP_SCRIPTS_BEFORE_CLEANUP=true
# --- test_run_r_close_browser_batch_execution (uses the CLOSE_TAB_* settings above too)
# number of sessions, and browsers (blank = one per 5 sessions)
CLOSE_TAB_BATCH_SESSIONS=10
CLOSE_TAB_BATCH_BROWSERS=
# seconds between starting one browser and the next
CLOSE_TAB_BATCH_BROWSER_STAGGER_S=30
