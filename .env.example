# Template for .env: copy this file to .env and fill in the blank values.
# Never put real URLs, users, passwords or tokens in this file - it is in git.

# --- Workbench server and users (user N = RSTUDIO_USER<N> / RSTUDIO_PASSWORD<N> / API_TOKEN_USER_<N>; user 1's password has no suffix)
# sign-in page, e.g. http://<host>:8787/auth-sign-in
RSTUDIO_BASE_URL=
RSTUDIO_USER1=
RSTUDIO_PASSWORD=
# API tests only
API_TOKEN_USER_1=
RSTUDIO_USER2=
RSTUDIO_PASSWORD2=
# API tests only
API_TOKEN_USER_2=

# --- Server folders (no defaults in the code - each test needs its own set)
# test user's home folder
WORKBENCH_HOME_DIR=/home/posit
# working folder for new sessions (also API tests)
RSTUDIO_WORKING_DIR=/home/posit
# output folder: test_167 / 168 / 167_multiple_times / run_high_throughput_job / launch_existing
OUTPUT_DIR_HIGH_THROUGHPUT=/home/posit
# output folder: group / CSV-session tests, and test_concurrent_sessions
OUTPUT_DIR_GENERATE_CSV=/home/posit

# --- R scripts on the server (one per test)
# test_167 / 168 / 167_multiple_times / run_high_throughput_job / launch_existing
R_SCRIPT_HIGH_THROUGHPUT=/home/posit/generate_10kb_csv.R
# group / CSV-session tests, and test_concurrent_sessions
R_SCRIPT_GENERATE_CSV=/home/posit/batch_mayur/generate_10kb_csv.R
# group tests, group B
R_SCRIPT_GROUP_B_WORKBENCH_JOB=/home/posit/sample_run_sleep.R
R_SCRIPT_GROUP_B_BACKGROUND_JOB=/home/posit/batch_mayur/git_status_5sec.R
# test_create_session_through_ui_and_run_script_group_multi_browser, group B
R_SCRIPT_GROUP_B_BACKGROUND_JOB_MULTI_BROWSER=/home/posit/batch_mayur/run_until_stopped.R
# test_run_r_close_browser
R_SCRIPT_CLOSE_TAB_JOB=/home/posit/batch_mayur/git_status_5sec.R
# test_concurrent_sessions_10min
R_SCRIPT_CONCURRENT_10MIN=/home/posit/batch_mayur/htp_10min.R
# test_concurrent_sessions_30min
R_SCRIPT_CONCURRENT_30MIN=/home/posit/batch_mayur/htp_30min.R
# test_concurrent_sessions_10min_s (writes pmx_10kb_output/ in each session's folder)
R_SCRIPT_SMALL_10MIN=/home/posit/batch_mayur/pmx_10kb_10min.R
# test_mgsolve_10min
MGSOLVE_SCRIPT=/home/posit/batch_mayur/mrgsolve_sim.R
# test_pknca_10min
PKNCA_SCRIPT=/home/posit/batch_mayur/pknca_nca_10min.R
# test_nlmixr_10min
NLMIXR_SCRIPT=/home/posit/batch_mayur/nlmixr2_sse_10min.R
# test_shiny_html_10min
SHINY_HTML_SCRIPT=/home/posit/batch_mayur/test_html_reports_shiny.R
# test_tidyverse_ggplot_10min
TINYVERSE_GGPLOT_SCRIPT=/home/posit/batch_mayur/tidyverse_ggplot2_10min.R

# --- R packages (installed before the 10-min workload tests run, when missing)
# repository to install from: auto = Posit Package Manager's Linux binaries of the
# R_PACKAGES_SNAPSHOT snapshot for the server's OS (no compiling); or a repository URL;
# blank = the session's own repository
R_PACKAGES_REPO=auto
# CRAN snapshot date for auto: from before R 4.5, as the server runs R 4.4
R_PACKAGES_SNAPSHOT=2025-03-31

# --- R source commands
# perf tests that create sessions
R_SOURCE_COMMAND_NEW_SESSIONS=source('sample_100mb.R')
# test_rstudio_source_script_perf
R_SOURCE_COMMAND_EXISTING_SESSIONS=source('sample_10mb.R')

# --- Session, user and browser counts
# sessions per multi-session test
RSTUDIO_SESSION_COUNT=3
# cap on parallel browsers
RSTUDIO_CONCURRENT_MAX_WORKERS=3
# test_create_edit_open_delete_text_file: seconds to keep looping create / open / edit / delete
TEXT_FILE_LOOP_DURATION_S=600
# test_pmt_10min: mrgsolve, nlmixr2, PKNCA, tidyverse and R_SCRIPT_SMALL_10MIN, one session of each per browser (a multiple of 5)
PMT_10MIN_SESSIONS=10
# runs per session
RSTUDIO_RUN_SCRIPT_COUNT=3
# simultaneous users
RSTUDIO_RUN_SCRIPT_CONCURRENT_USERS=3
# cap on parallel browsers
RSTUDIO_RUN_SCRIPT_CONCURRENT_MAX_WORKERS=3
# test_run_r_close_browser: number of sessions
CLOSE_TAB_SESSION_COUNT=3
# test_run_r_close_browser_batch_execution: number of sessions, and browsers (blank = one per 5 sessions)
CLOSE_TAB_BATCH_SESSIONS=10
CLOSE_TAB_BATCH_BROWSERS=

# --- Browser start timings
# concurrent tests (all three): seconds between starting one browser and the next
CONCURRENT_SESSIONS_BROWSER_STAGGER_S=30
# concurrent tests: seconds over which the browsers start their scripts once all are
# ready (0 = all at the same moment); e.g. 60 eases the load peaks on the machine
# running the browsers and on the server
CONCURRENT_START_SPREAD_S=0
# test_create_session_through_ui_and_run_script_group_multi_browser: seconds between starting one browser and the next
GROUP_SESSIONS_UI_BROWSER_STAGGER_S=30
# test_run_r_close_browser_batch_execution: seconds between starting one browser and the next
CLOSE_TAB_BATCH_BROWSER_STAGGER_S=30

# --- Run durations
# time limit per high-throughput run
HIGH_THROUGHPUT_JOB_TEST_DURATION_SECONDS=240
# how long sessions run with tabs closed
RSTUDIO_WORKBENCH_JOB_TEST_DURATION_SECONDS=240
# test_run_r_close_browser (and _batch_execution): seconds the sessions run with their tabs closed
# (the Jenkins CLOSE_BROWSER_WAIT_S field wins when set)
CLOSE_TAB_TEST_DURATION_S=240
# test_rstudio_sessions idle time
RSTUDIO_SESSION_IDLE_MINUTES=3
# pause between runs
RSTUDIO_RUN_SCRIPT_THINK_TIME_SECONDS=5

# --- Timeouts and limits
# script timeout in existing sessions
RSTUDIO_SCRIPT_TIMEOUT_MS=600000
# script timeout in new sessions
RSTUDIO_RUN_SCRIPT_TIMEOUT_MS=600000
# fail if p95 launch time is above this
RSTUDIO_LAUNCH_P95_MAX_SECONDS=60

# --- Poll / check intervals
# test_rstudio_sessions poll interval
RSTUDIO_FILE_LIST_POLL_INTERVAL_SECONDS=30
# test_concurrent_sessions_10min_s: ms between checks of each console (e.g. 5000 eases the load)
CONCURRENT_SMALL_10MIN_POLL_MS=500
# test_run_r_close_browser (and _batch_execution): seconds between checks of the session list for dropped sessions
CLOSE_TAB_MONITOR_INTERVAL_S=30

# --- Cleanup
# test_run_r_close_browser (and _batch_execution): true = reopen each session and stop its R script before the sessions are quit
CLOSE_TAB_STOP_SCRIPTS_BEFORE_CLEANUP=true

# ==========================================================================
# NEW (2026-10-26): concurrent load files / background job / idle / scenario 1 tests
# ==========================================================================
# test_concurrent_bj: script run as an RStudio background job (should loop until stopped)
BACKGROUND_JOB_SCRIPT=/home/posit/batch_mayur/run_until_stopped.R
# test_concurrent_loadfiles: sessions, seconds to keep calling, wait after each answer
# (LOAD_FILES_COMMAND blank = list.files(RSTUDIO_WORKING_DIR))
LOAD_FILES_SESSIONS=2
LOAD_FILES_DURATION_S=600
LOAD_FILES_WAIT_S=30
LOAD_FILES_COMMAND=
# test_concurrent_bj: sessions (5 tabs per browser, one browser per 5 sessions), seconds each
# background job runs before it is stopped, seconds between job checks, and the folder the jobs
# work in (<folder>/<session name>; blank = OUTPUT_DIR_GENERATE_CSV)
BACKGROUND_SESSIONS=5
BACKGROUND_JOB_DURATION=600
BACKGROUND_JOB_CHECK_INTERVAL_S=60
BACKGROUND_JOB_OUTPUT_DIR=
# test_concurrent_idle: sessions (5 tabs per browser, one browser per 5 sessions), seconds the
# tabs are kept open idle before every session is force-quit, and seconds between drop checks
# (each check: the tab still shows the IDE, and the session list still shows it Active/Executing)
CONCURRENT_IDLE_SESSIONS=5
CONCURRENT_IDLE_DURATION=600
CONCURRENT_IDLE_CHECK_INTERVAL_S=60
# test_concurrent_scenario_1: sessions in the mix 1 file crud : 1 idle : 1 small 10min script : 2 load files
# per 5 (one browser each), and seconds the workloads run (each uses its own test's other settings)
CONCURRENT_SESSIONS_SCENARIO=5
CONCURRENT_SESSIONS_SCENARIO_DURATION=600
# R package setup (test_pmt_10min, test_<name>_10min): true = also reinstall packages whose version differs
# from the R_PACKAGES_SNAPSHOT repository's; false = install only packages that are not installed
R_PACKAGES_CHECK_VERSIONS=false
