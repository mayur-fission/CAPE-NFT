# ======================= SHARED (used by every test) =======================

# --- Workbench server and users (user N = RSTUDIO_USER<N> / RSTUDIO_PASSWORD<N> / API_TOKEN_USER_<N>; user 1's password has no suffix)
# sign-in page, e.g. http://<host>:8787/auth-sign-in
RSTUDIO_BASE_URL=http://100.63.230.151:8787/auth-sign-in
# user 1
RSTUDIO_USER1="posit"
RSTUDIO_PASSWORD="posit"
# API token (session list / quit calls)
API_TOKEN_USER_1="JU/DF3ixzEIDx1JuA5LTinNb9/0/6rIJ"
# user 2
RSTUDIO_USER2='mayur'
RSTUDIO_PASSWORD2='test@123'
# API token (session list / quit calls)
API_TOKEN_USER_2="G1bQ5vpZU4+0FHTDJ8Heu01ENxL4nlfr"

# --- Server paths (no defaults in the code)
# test user's home folder (concurrent tests: 167, 168, fsync, mrgsolve)
WORKBENCH_HOME_DIR=/mnt/fsx
# working folder for new sessions (all tests; the text files and API sessions go here too)
RSTUDIO_WORKING_DIR=/mnt/fsx

# --- Timings shared by the tests
# seconds between login starts across all test processes (parallel runs: logins take ~10s under load)
LOGIN_MIN_INTERVAL_S=12
# longest one setwd() may take, in seconds (all tests; raise it for a slow mount such as /mnt/svmroot)
SETWD_TIMEOUT_S=60
# concurrent tests (167, 168, fsync, mrgsolve): start the browsers' scripts over this many seconds
# instead of all at once (eases the load peaks on the machine running the browsers)
CONCURRENT_START_SPREAD_S=120

# ======================= PER TEST ===========================================
# test_active_session_count and test_delete_sessions need only the shared settings above.

# --- test_create_edit_open_delete_text_file
# seconds to keep looping create / open / edit / delete
TEXT_FILE_LOOP_DURATION_S=120

# --- test_cleanup_leftover_testdata
# output folders swept for leftover session folders (besides RSTUDIO_WORKING_DIR)
OUTPUT_DIR_GENERATE_CSV=/mnt/fsx
OUTPUT_DIR_HIGH_THROUGHPUT=/mnt/fsx
BACKGROUND_JOB_OUTPUT_DIR=

# --- test_mrgsolve_setup (installs the R packages test_mrgsolve_concurrent needs)
# R packages the script needs, installed by test_mrgsolve_setup.py when missing (comma-separated; blank = mrgsolve; none = no check)
MRGSOLVE_R_PACKAGES=

# --- test_mrgsolve_concurrent and test_mrgsolve_concurrent_batch
# Each run: <working dir>/MRGSOLVE_VALIDATION[_<suffix>]_<sessions>_<datetime>/, holding SESSION_<N>
# for session ..._S<N> (its working directory). Output is never deleted.
# R script sourced in every session
MRGSOLVE_SCRIPT=/mnt/fsx/CAPE_2026_11_0223/run_mrgsolve.R
# working directory the run folders go in (blank = the folder MRGSOLVE_SCRIPT is in)
MRGSOLVE_WORKING_DIR=/mnt/fsx/CAPE_2026_11_0223
# number of sessions (..._S1 .. _S<N>)
MRGSOLVE_SESSIONS=10
# optional suffix (blank = none), e.g. U1:
#   sessions   MRGSOLVE_VALIDATION_U1_S<N>   (blank: MRGSOLVE_VALIDATION_S<N>)
#   run folder MRGSOLVE_VALIDATION_U1_<sessions>_<datetime>/SESSION_<N>   (blank: MRGSOLVE_VALIDATION_<sessions>_<datetime>)
# test_delete_sessions quits every MRGSOLVE_VALIDATION_* session, whatever its suffix.
MRGSOLVE_SESSION_SUFFIX=
# browsers to spread the sessions over (blank = one browser per 5 sessions)
MRGSOLVE_SESSIONS_BROWSERS=
# seconds between starting one browser and the next
CONCURRENT_SESSIONS_BROWSER_STAGGER_S=30
# longest one script run may take, in minutes (the script runs ~20 min)
MRGSOLVE_SCRIPT_TIMEOUT_MIN=1000
# how often each console is checked for the end of the script, in ms
MRGSOLVE_POLL_MS=500
# files the script writes in its session folder that must exist afterwards (comma-separated; blank = no check)
MRGSOLVE_OUTPUT_FILES=
# run summary file in the pmx scripts' format read into the timings (blank = none; the
# mrgsolve_run_summary_PID_*.csv table is read regardless)
MRGSOLVE_RUN_SUMMARY=
# slow-session limit in seconds drawn on the session time charts (blank = none)
MRGSOLVE_THRESHOLD_S=

# --- test_mrgsolve_concurrent_new (proof that N sessions run the script concurrently, e.g. 5 workspaces x 40)
# Uses the MRGSOLVE_* settings above. Run test_mrgsolve_r_script_concurrent_new in every workspace
# (own suffix and index each), then test_mrgsolve_concurrency_report once, after all have finished.
# Start modes:
#   spike     MRGSOLVE_START_AT set                          - all start together on the server clock
#   staggered MRGSOLVE_START_AT + MRGSOLVE_RAMP_UP_S          - one start every RAMP_UP_S / all sessions
#   as ready  MRGSOLVE_START_AT blank + MRGSOLVE_RUN_TAG set  - each browser starts when its sessions are up
# start time on the server clock, the same in every workspace: Unix epoch, HH:MM[:SS] (today) or
# YYYY-MM-DD HH:MM[:SS], this machine's local time; far enough ahead to launch every session
# (~8 min for 10 sessions). Blank = as-ready mode
MRGSOLVE_START_AT=
# staggered start: seconds over which every session of every workspace starts (600 s / 200 sessions = one
# every 3 s; 0 = no ramp-up)
MRGSOLVE_RAMP_UP_S=0
# staggered start: seconds between two starts, used when MRGSOLVE_RAMP_UP_S is 0 (0 = all at once)
MRGSOLVE_START_INTERVAL_S=0
# this workspace's number (1..MRGSOLVE_WORKSPACE_COUNT) and the number of workspaces: the starts are
# interleaved U1-S1, U2-S1, ..., U5-S1, U1-S2, ...
MRGSOLVE_WORKSPACE_INDEX=1
MRGSOLVE_WORKSPACE_COUNT=1
# name of the shared timing folder <working dir>/MRGSOLVE_CONCURRENCY_<tag>, the same in every workspace
# (letters, digits, - and _; blank = the start epoch; needed for the report in as-ready mode)
MRGSOLVE_RUN_TAG=
# runs of the script per session, and the pause between them in seconds (R stays busy: no suspension)
MRGSOLVE_ITERATIONS=1
MRGSOLVE_THINK_TIME_S=0
# idle time before a session's script starts above this (s) is reported (sessions may be suspended after 10 min)
MRGSOLVE_IDLE_WARN_S=480
# runs that must be running at the same time for the concurrency report to pass
MRGSOLVE_EXPECTED_CONCURRENT=200
# how often each console is checked for the end of the script, in ms (timing comes from the server)
MRGSOLVE_NEW_POLL_MS=5000

# --- test_167 (mrgsolve scenario 1: run_mrgsolve.R in one new session, timed)
# The test sets no time limit: the run time is set in the R script (TARGET_SECONDS), which stops by itself.
# Each run: <working dir>/167_mrgsolve_scenario1_<datetime>/ is the session's working directory (never deleted).
# R script sourced in the session
TEST_167_SCRIPT=/mnt/fsx/CAPE_2026_11_0223/run_mrgsolve.R
# working directory the run folder goes in (blank = the folder TEST_167_SCRIPT is in)
TEST_167_WORKING_DIR=/mnt/fsx/CAPE_2026_11_0223
# user the session is launched as
TEST_167_USER=1
# session launch: attempts, timeout per attempt (minutes), seconds between attempts
TEST_167_LAUNCH_ATTEMPTS=3
TEST_167_LAUNCH_TIMEOUT_MIN=3
TEST_167_LAUNCH_RETRY_WAIT_S=15
# how often the console is checked for the end of the script, in ms
TEST_167_POLL_MS=500
# slow-session limit in seconds drawn on the session time chart (blank = none)
TEST_167_THRESHOLD_S=

# --- test_168 (mrgsolve scenario 3: run_mrgsolve.R in RSTUDIO_168_COUNT new sessions at once, timed)
# Also used by test_168_multiple_times: script, working dir, user, launch, poll and threshold settings.
# The test sets no time limit: the run time is set in the R script (TARGET_SECONDS), which stops by itself.
# Each run: <working dir>/168_mrgsolve_scenario3_<datetime>/session1 .. session<N>, one folder per session (never deleted).
# R script sourced in every session (same script as test_167)
TEST_168_SCRIPT=/mnt/fsx/CAPE_2026_11_0223/run_mrgsolve.R
# working directory the run folder goes in (blank = the folder TEST_168_SCRIPT is in)
TEST_168_WORKING_DIR=/mnt/fsx/CAPE_2026_11_0223
# number of sessions (168_AUTO_SESSION_1 .. _<N>)
RSTUDIO_168_COUNT=3
# browsers to spread the sessions over (blank = one browser per 5 sessions)
TEST_168_BROWSERS=
# seconds between starting one browser and the next
TEST_168_BROWSER_STAGGER_S=30
# user the sessions are launched as
TEST_168_USER=1
# session launch: attempts, timeout per attempt (minutes), seconds between attempts
TEST_168_LAUNCH_ATTEMPTS=3
TEST_168_LAUNCH_TIMEOUT_MIN=3
TEST_168_LAUNCH_RETRY_WAIT_S=15
# how often each console is checked for the end of the script, in ms
TEST_168_POLL_MS=500
# slow-session limit in seconds drawn on the session time charts (blank = none)
TEST_168_THRESHOLD_S=

# --- test_168_multiple_times (mrgsolve scenario 2: run_mrgsolve.R in one session, repeated; uses the TEST_168_* settings above too)
# Each test run: <working dir>/168_mrgsolve_scenario2_<datetime>/run1 .. run<N>, one folder per run (never deleted).
# number of runs, one after another (a new login and session each time)
TEST_168_MULTIPLE_RUNS=3
# minutes to wait after a run finishes before the next one starts (decimals allowed, 0 = no wait)
TEST_168_MULTIPLE_WAIT_MIN=1

# --- test_fsync_concurrent (per-session venv setup + R/Python files, then the R file in all sessions at once)
# Each run: <FSYNC_BASE>/fsync_<sessions>_sessions_<datetime>/session1 .. session<N>, one folder per
# session (FSYNC_SESSION_<N>), each with its own venv/ and copies of the files (never deleted).
# concurrency: number of sessions set up and running the R file at the same time
FSYNC_SESSIONS=1
# browsers to spread the sessions over (blank = one browser per 5 sessions)
FSYNC_BROWSERS=
# seconds between starting one browser and the next
FSYNC_BROWSER_STAGGER_S=30
# user the sessions are launched as
FSYNC_USER=1
# session launch: attempts, timeout per attempt (minutes), seconds between attempts
FSYNC_LAUNCH_ATTEMPTS=3
FSYNC_LAUNCH_TIMEOUT_MIN=3
FSYNC_LAUNCH_RETRY_WAIT_S=15
# $BASE of the setup commands (cd $BASE, df -h $BASE); the run folders go in it (or /mnt/svmroot/CAPE_2026_11_0111)
FSYNC_BASE=/fsx/fsx_data
# how the files get into each session folder: copy (server paths below, copied on the server) or
# upload (local paths below, relative to the repo, sent through the Files pane's Upload button)
FSYNC_FILES_MODE=copy
# R file sourced in every session (required) and Python file put next to it (blank = none)
FSYNC_R_FILE=/mnt/fsx/CAPE_2026_11_0223/run_load.R
FSYNC_PY_FILE=/mnt/fsx/CAPE_2026_11_0223/250gb_data_generator.py
# python used to create the venv
FSYNC_PYTHON=python3
# longest one setup command (e.g. python3 -m venv) may take, in minutes
FSYNC_SETUP_TIMEOUT_MIN=10
# lines of each session's console printed when its R file finishes (no time limit on the R file: it runs until it ends by itself)
FSYNC_CONSOLE_TAIL_LINES=25
# text run_load.R prints once its load starts (and ends, if you add one); a session whose console lacks any fails
# (comma-separated; none = no check)
FSYNC_EXPECTED_OUTPUT=RUN START
# text that means the load failed although R finished (e.g. a Python crash inside system()); a session whose
# console shows any of it fails (comma-separated; none = no check)
FSYNC_FAIL_OUTPUT=Traceback (most recent call last)
# how often each console is checked for the end of the R file, in ms
FSYNC_POLL_MS=500
# slow-session limit in seconds drawn on the session time charts (blank = none)
FSYNC_THRESHOLD_S=

# --- test_create_multiple_sessions (launch sessions, setwd, leave idle; uses CONCURRENT_SESSIONS_* launch settings)
# number of sessions (CREATE_MULTIPLE_[<suffix>_]S1 .. S<N>)
CREATE_MULTIPLE_SESSIONS=5
# optional suffix in the session names (blank = none), e.g. U1
CREATE_MULTIPLE_SESSION_SUFFIX=
# browsers to spread the sessions over (blank = one browser per 5 sessions)
CREATE_MULTIPLE_SESSIONS_BROWSERS=
# working directory set in every session (blank = WORKBENCH_HOME_DIR, else RSTUDIO_WORKING_DIR)
CREATE_MULTIPLE_WORKING_DIR=
# seconds the sessions are left idle (600 = 10 minutes)
CREATE_MULTIPLE_IDLE_S=600
# seconds between drop checks while idle
CREATE_MULTIPLE_CHECK_INTERVAL_S=60
