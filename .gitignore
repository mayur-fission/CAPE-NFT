# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets
.env
.env.*
!.env.example

# Test output: Allure results/report and each run's own folder
# (evidence/runs/<time>_<test file>/: CSVs, charts, JSON, screenshots), plus
# pytest-playwright traces
evidence/*
!evidence/.gitkeep
test-results/
*.log

# Files the tests generate in testdata/ (the input CSVs stay tracked)
testdata/session_ids_U*.csv
testdata/session_projects_U*.xlsx

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Allure command line the Jenkinsfile downloads, and the report it builds
.allure-cli/
allure-report-single/
allure-report.html
allure-report.zip
